# Cencori Runtime Control Layer API Key (https://cencori.com)
CENCORI_API_KEY=csk_your_cencori_api_key_here

# Groq AI API Key (Alternative Cloud Provider)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Database Connection URL (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite://dabar.sqlite3?mode=rwc

# Server Port
PORT=8000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://dabar-beta.vercel.app

# Optional: Custom binary paths for yt-dlp and ffmpeg if not present on system PATH
# YT_DLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/local/bin/ffmpeg

# Optional: YouTube authentication cookies to bypass datacenter IP bot detection ("Sign in to confirm you're not a bot").
# Export cookies from a logged-in YouTube session using a browser extension (e.g. "Get cookies.txt LOCALLY").
# Upload the file to the server via Render's Secret Files feature (e.g. /etc/secrets/cookies.txt) or save locally as cookies.txt.
# WARNING: Do NOT commit your cookies file to GitHub repository!
YT_DLP_COOKIES_PATH=""
