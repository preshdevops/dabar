{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dabar",
  "version": "0.1.0",
  "identifier": "com.dabar.app",
  "build": {
    "beforeDevCommand": "npm --prefix apps/web run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix apps/web run build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dabar",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
